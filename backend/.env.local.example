# ============================================================================
# Exemple de configuration locale du backend.
#
# Les scripts d'installation (scripts/install.ps1 et scripts/install.sh) génèrent ce fichier
# automatiquement sous le nom ".env.local". Pour une installation manuelle :
#   1. copie ce fichier en ".env.local"  (il est ignoré par git : jamais de secret dans le dépôt)
#   2. remplace les valeurs ci-dessous
#   3. génère les clés JWT :  php bin/console lexik:jwt:generate-keypair
#
# Ne modifie jamais ".env" : c'est le fichier commité, avec les valeurs par défaut.
# ============================================================================

APP_ENV=dev

# Secret de l'application (jetons CSRF, signatures...). Génération : php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=remplace-par-une-valeur-aleatoire-de-64-caracteres

# Connexion PostgreSQL : postgresql://UTILISATEUR:MOT_DE_PASSE@HÔTE:PORT/BASE?serverVersion=VERSION_MAJEURE&charset=utf8
# (sans mot de passe : postgresql://UTILISATEUR@HÔTE:PORT/BASE?...)
# Si le mot de passe contient des caractères spéciaux (@ : / ? # % espace...), encode-les (ex : @ devient %40)
# PUIS double chaque "%" ("%%40"), car Symfony lit cette valeur en interprétant "%...%" comme un paramètre.
# (Les scripts d'installation le font à ta place.)
DATABASE_URL="postgresql://datashare:mot-de-passe@127.0.0.1:5432/datashare?serverVersion=16&charset=utf8"

# Clés de signature des jetons JWT (connexion). Le mot de passe protège la clé privée.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=remplace-par-une-phrase-secrete-aleatoire

# Adresse du site (frontend), utilisée pour construire les liens de partage : <FRONT_URL>/<token>
FRONT_URL=http://localhost:5173
